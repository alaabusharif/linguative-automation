PORT=4000
SESSION_SECRET=change-this-to-a-long-random-string
# Bootstrap admin account created on first run if no users exist yet:
ADMIN_USERNAME=ala
ADMIN_PASSWORD=change-this-before-first-run

# Bank details printed in the "Payment Details" block on invoice PDFs only
# (never on quotes). Left unset, the block is simply skipped. These are
# real banking details — set them only in the server's own .env, never
# commit real values here or anywhere else in the repo.
BANK_BENEFICIARY=
BANK_ACCOUNT_NUMBER=
BANK_NAME=
BANK_BRANCH=
BANK_ADDRESS=
BANK_IBAN=
BANK_SWIFT=
