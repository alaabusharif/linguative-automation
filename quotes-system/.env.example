PORT=4000
SESSION_SECRET=change-this-to-a-long-random-string
# Bootstrap admin account created on first run if no users exist yet:
ADMIN_USERNAME=ala
ADMIN_PASSWORD=change-this-before-first-run

# Bank details printed in the "Payment Details" block on invoice PDFs only
# (never on quotes). One account per currency the invoice can be issued in —
# the invoice's own Currency field (JOD or USD) picks which one is printed.
# Left unset, that currency's block is simply skipped. These are real
# banking details — set them only in the server's own .env, never commit
# real values here or anywhere else in the repo.
BANK_JOD_BENEFICIARY=
BANK_JOD_ACCOUNT_NUMBER=
BANK_JOD_NAME=
BANK_JOD_BRANCH=
BANK_JOD_ADDRESS=
BANK_JOD_IBAN=
BANK_JOD_SWIFT=

BANK_USD_BENEFICIARY=
BANK_USD_ACCOUNT_NUMBER=
BANK_USD_NAME=
BANK_USD_BRANCH=
BANK_USD_ADDRESS=
BANK_USD_IBAN=
BANK_USD_SWIFT=
