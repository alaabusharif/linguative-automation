PORT=4000
SESSION_SECRET=change-this-to-a-long-random-string
# Bootstrap admin account created on first run if no users exist yet:
ADMIN_USERNAME=ala
ADMIN_PASSWORD=change-this-before-first-run

# Bank details and tax/registration numbers are now set from the app's own
# Settings screen (admin login → Settings), saved in data/quotes.db — not
# here. These env vars are an OPTIONAL one-time fallback, only read the very
# first time the app starts with nothing saved yet in Settings; once
# anything is saved there, these are ignored. Left unset, nothing breaks —
# the Payment Details section is just skipped until Settings is filled in.
# These are real banking details — never commit real values here or
# anywhere else in the repo.
BANK_JOD_BENEFICIARY=
BANK_JOD_ACCOUNT_NUMBER=
BANK_JOD_NAME=
BANK_JOD_BRANCH=
BANK_JOD_ADDRESS=
BANK_JOD_IBAN=
BANK_JOD_SWIFT=

BANK_USD_BENEFICIARY=
BANK_USD_ACCOUNT_NUMBER=
BANK_USD_NAME=
BANK_USD_BRANCH=
BANK_USD_ADDRESS=
BANK_USD_IBAN=
BANK_USD_SWIFT=

# JoFotara (Jordan national e-invoicing) credentials — optional, same
# one-time-fallback rule as the bank vars above: set from the app's own
# Settings screen (admin login → Settings → JoFotara) instead, which is
# the normal way to set these. Generated from the JoFotara portal's
# "ربط الأجهزة" (Device Linking) screen. Leave unset until an invoice
# actually needs to be sent there — nothing is submitted automatically.
JOFOTARA_CLIENT_ID=
JOFOTARA_SECRET_KEY=
JOFOTARA_INCOME_SOURCE=
# Override only if ISTD publishes a new endpoint; the default below is current.
JOFOTARA_API_URL=https://backend.jofotara.gov.jo/core/invoices/
